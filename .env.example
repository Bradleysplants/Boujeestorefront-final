# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_* values are exposed to the browser.

# --- Required -------------------------------------------------------------
# Medusa backend (must be running and reachable at BUILD time as well as run
# time: pages such as categories/collections/products are pre-rendered from it).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Public URL of this storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000
# Fallback country code (ISO-2) when the visitor's country has no region.
NEXT_PUBLIC_DEFAULT_REGION=us

# --- Payments (leave empty to disable the provider) -----------------------
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Cache revalidation (not read by the code today; kept from the original setup) ---
REVALIDATE_SECRET=change-me

# --- Search (only if "search": true in store.config.json) -----------------
NEXT_PUBLIC_SEARCH_ENDPOINT=http://127.0.0.1:7700
NEXT_PUBLIC_SEARCH_API_KEY=
NEXT_PUBLIC_INDEX_NAME=products
# Only when switching to Algolia (see README):
# NEXT_PUBLIC_SEARCH_APP_ID=
